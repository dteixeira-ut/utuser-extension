{
  "manifest_version": 3,
  "name": "Insights Utils",
  "version": "1.0",
  "description": "A simple Chrome extension to gather account id, workspace id and user id from the current page.",
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": ["scripting", "activeTab"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": [
        "https://participant.development-use2.usertesting.com/candidate/outcome/complete*",
        "https://participant.staging-use2.usertesting.com/candidate/outcome/complete*",
        "https://participant.use2.usertesting.com/candidate/outcome/complete*"
      ],
      "js": ["participant-retake.js"],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  }
}
